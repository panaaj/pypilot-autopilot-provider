{
    "name": "pypilot-autopilot-provider",
    "version": "1.1.5-rc1",
    "description": "PyPilot autopilot provider plugin for Signal K server.",
    "main": "plugin/index.js",
    "signalk": {
        "displayName": "PyPilot Autopilot Provider",
        "appIcon": "./app-icon.svg"
    },
    "keywords": [
        "signalk-node-server-plugin",
        "pypilot"
    ],
    "repository": "https://github.com/panaaj/pypilot-autopilot-provider",
    "author": "AdrianP",
    "contributors": [
        {
            "name": "panaaj@hotmail.com"
        }
    ],
    "license": "Apache-20",
    "scripts": {
        "build": "tsc",
        "build-declaration": "tsc --declaration --allowJs false",
        "watch": "npm run build -- -w",
        "test": "mocha",
        "start": "npm run build -- -w",
        "format": "prettier --write src/*",
        "prepublishOnly": "npm run format && npm run build",
        "prepack": "npm run format && npm run build"
    },
    "dependencies": {
        "@signalk/server-api": "^2.28.0",
        "socket.io-client": "^4.4.1"
    },
    "devDependencies": {
        "@tsconfig/node20": "^20.1.6",
        "@types/express": "^5.0.3",
        "@types/node-fetch": "^2.6.13",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3"
    },
    "signalk-plugin-enabled-by-default": false
}
